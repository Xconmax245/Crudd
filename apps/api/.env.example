 # Supabase PostgreSQL Connection
# DATABASE_URL: Transactional connection (pgbouncer / connection pool)
# DIRECT_URL: Direct connection for Prisma migrations
DATABASE_URL="postgres://postgres.xxx:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.xxx:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Application
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Redis — live match state for the real-time engine (Phase 2).
# Start locally with: docker compose -f docker/docker-compose.yml up -d
REDIS_URL=redis://localhost:6379

# Supabase Auth (admin dashboard authentication)
# SUPABASE_URL: your project URL, e.g. https://xxxx.supabase.co
# SUPABASE_ANON_KEY: the public anon key (used to verify user access tokens)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated allow-list of emails auto-provisioned as SUPER_ADMIN on first login.
ADMIN_BOOTSTRAP_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Observability (Task 4)
# ---------------------------------------------------------------------------

# Sentry error tracking — OPTIONAL.
# Leave blank to run without Sentry (API still starts normally).
# Get your DSN from https://sentry.io → Project → Client Keys.
SENTRY_DSN=

# Sentry release environment label shown in the Sentry dashboard.
SENTRY_ENVIRONMENT=development

# Fraction of transactions to sample for performance tracing (0–1).
# Use 0 for no tracing, 0.1 for 10%, 1.0 for all.
SENTRY_TRACES_SAMPLE_RATE=0

# Pino log level: trace | debug | info | warn | error | fatal
# Defaults to 'debug' in development and 'info' in production.
LOG_LEVEL=debug
