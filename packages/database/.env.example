# ---------------------------------------------------------------------------
# @crudd/database — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Supabase PostgreSQL
# ---------------------------------------------------------------------------
#
# DATABASE_URL — runtime / query connection (pgbouncer / connection pool).
#   Used by Prisma Client for all normal read/write queries.
#   Include ?pgbouncer=true when using Supabase's transaction-mode pooler.
#   Port 6543 = Supabase transaction-mode pooler (recommended for production).
#
DATABASE_URL="postgres://postgres.xxx:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL — schema management connection (direct, bypasses pgbouncer).
#   Used by Prisma for migrations (`prisma migrate deploy`) and introspection.
#   Must NOT use the pgbouncer endpoint; port 5432 = direct Postgres connection.
#   This is intentionally separate from DATABASE_URL.
#
DIRECT_URL="postgres://postgres.xxx:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"
