# ===========================================================================
# CRUDD — production compose env template.
# Copy to `.env.prod`, fill in real values, and run:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# `.env.prod` is gitignored; this .example file is committed. See docs/env.md.
# ===========================================================================

# --- Bundled Postgres (the `postgres` service) ---
POSTGRES_USER=crudd
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=crudd

# --- API: database + cache ---
# Point at the compose service names (`postgres`, `redis`).
DATABASE_URL=postgres://crudd:change-me-strong-password@postgres:5432/crudd
DIRECT_URL=postgres://crudd:change-me-strong-password@postgres:5432/crudd
REDIS_URL=redis://redis:6379

# --- API: public origins (CORS + share links) ---
FRONTEND_URL=https://play.example.com
ADMIN_URL=https://admin.example.com
LANDING_URL=https://www.example.com

# --- API: admin auth (Supabase) ---

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
ADMIN_BOOTSTRAP_EMAILS=you@example.com

# --- Observability ---
# Sentry error tracking — leave blank to disable (API starts normally without it)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info

# --- Web + Admin build-time public config (baked into the static bundles) ---
VITE_API_URL=https://api.example.com
VITE_SOCKET_URL=https://api.example.com
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Landing build-time public config (where its CTAs send visitors) ---
# Defaults to FRONTEND_URL if omitted.
VITE_APP_URL=https://play.example.com

# --- Published host ports (optional; sensible defaults applied if omitted) ---
API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=3002
LANDING_PORT=3003
